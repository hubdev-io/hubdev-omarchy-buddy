    {
      "dot": "rose",
      "title": "Pure JS",
      "items": [
        "Every rule lives in Model / Actions / Theme",
        "No QML imports, so node can load them",
        "Swap SourceJson.js to change the transport"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two ways to act",
      "items": [
        "Detached: Util.execArgv opens URL, terminal, editor",
        "Waited on: runAction for service, caddy, php verbs",
        "argv only from the Actions.js allowlists",
        "Exit code > Actions.parseResult > refusal in panel"
      ]
    },
    {
      "dot": "cyan",
      "title": "When it asks",
      "items": [
        "Panel closed: full tier, refresh interval (30s)",
        "Panel open: cheap tier every 5s, full every 30s",
        "Unreachable: back off to 60s",
        "merge(): absent keeps the last, [] means empty"
      ]
    }
